# The state API refuses to answer without this.
# Local development:
#   createdb han && psql -d han -f db/schema.sql
DATABASE_URL=postgresql://user@localhost:5432/han

# Development only: return the password-reset code in the API response so the
# flow can be completed without an SMS gateway. Ignored in production.
HAN_DEV_SHOW_RESET_CODE=0

# How a password-reset code reaches a person. Without one the code is only
# written to the server log, and the sign-in screen says so rather than
# promising an SMS that is not coming.
#   log      (default) write to the log, deliver nothing
#   webhook  POST the message to HAN_NOTIFY_URL and let that side own the
#            provider — deliberately generic, so choosing an operator later
#            needs no code change here
HAN_NOTIFY=log
# HAN_NOTIFY_URL=https://example.internal/han/sms
# HAN_NOTIFY_SECRET=
